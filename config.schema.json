{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IConfig",
    "definitions": {
        "IConfig": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "directories": {
                    "$ref": "#/definitions/IDataDirectories",
                    "description": "Explicit absolute locations for independently owned archives."
                },
                "collector": {
                    "$ref": "#/definitions/IConfigCollector",
                    "description": "Selected server Collector source; desktop-only configurations do not start a Collector."
                },
                "simBroker": {
                    "$ref": "#/definitions/ISimBrokerServiceConfig",
                    "description": "Independent simulated broker process configuration."
                },
                "trader": {
                    "$ref": "#/definitions/IOperationalTraderConfig",
                    "description": "Trader configuration"
                },
                "batchServices": {
                    "type": "object",
                    "properties": {
                        "massive": {
                            "$ref": "#/definitions/IConfigServerBatchService"
                        },
                        "alpaca": {
                            "type": "object",
                            "properties": {
                                "rateLimit": {
                                    "$ref": "#/definitions/IConfigRateLimit"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false,
                    "description": "Third-party batch service configuration used by scheduler and importers"
                }
            },
            "required": [
                "directories",
                "collector",
                "trader"
            ],
            "additionalProperties": false,
            "description": "Main configuration"
        },
        "IDataDirectories": {
            "type": "object",
            "properties": {
                "accounts": {
                    "type": "string"
                },
                "reference": {
                    "type": "string"
                },
                "market": {
                    "type": "string"
                },
                "journals": {
                    "type": "string"
                },
                "operations": {
                    "type": "string"
                }
            },
            "required": [
                "accounts",
                "reference",
                "market",
                "journals",
                "operations"
            ],
            "additionalProperties": false,
            "description": "Independently located archives; only reference storage may be shared with a server."
        },
        "IConfigCollector": {
            "type": "object",
            "properties": {
                "provider": {
                    "type": "string",
                    "const": "massive"
                },
                "feed": {
                    "type": "string",
                    "enum": [
                        "realtime",
                        "delayed"
                    ],
                    "description": "Massive subscription tier: delayed delivers the original market timestamps 15 minutes later."
                }
            },
            "required": [
                "provider",
                "feed"
            ],
            "additionalProperties": false,
            "description": "One global source is selected for Collector, Live and provider-backed SimBroker."
        },
        "ISimBrokerServiceConfig": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ISimBrokerProviderConfig"
                },
                {
                    "$ref": "#/definitions/ISimBrokerHistoricalConfig"
                }
            ]
        },
        "ISimBrokerProviderConfig": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Filesystem-safe identity; changing it starts a separate environment.",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                "port": {
                    "type": "number",
                    "description": "Loopback web/API port.",
                    "minimum": 1,
                    "maximum": 65535
                },
                "simulationProfile": {
                    "$ref": "#/definitions/ISimBrokerServiceProfile"
                },
                "accountTemplate": {
                    "type": "object",
                    "properties": {
                        "notificationsEnabled": {
                            "type": "boolean",
                            "description": "Whether this account may deliver notifications through globally configured channels; absence means disabled"
                        },
                        "soundsEnabled": {
                            "type": "boolean",
                            "description": "Whether the Live client may play position lifecycle sounds for this account; absence means disabled"
                        },
                        "instrumentPoolIds": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Instrument pool ids that the account can use. If undefined, the account can use all instruments available in the context."
                        },
                        "strategySlugs": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/StrategySlug"
                            },
                            "description": "Strategy slugs that the account can use. If undefined, the account can use all configured strategy slugs. Slugs are composed as `<series>.<branch>`."
                        },
                        "defaultRiskProfileId": {
                            "type": "string",
                            "description": "Complete risk profile selected for this account."
                        },
                        "maxLossPerDay": {
                            "$ref": "#/definitions/ICompositeValue",
                            "description": "Optional Backtest account replacement for trader.defaultMaxLossPerDay. Fixed values use account currency; percentage values use risk-day opening equity adjusted for nontrading cash flows. Historical and Live execution block subsequent entries after an observed breach without liquidating positions or canceling accepted orders. A selected entry-risk profile cannot change this account-wide limit."
                        },
                        "tax": {
                            "type": "object",
                            "properties": {
                                "profileId": {
                                    "type": "string",
                                    "description": "Country-level tax profile id"
                                },
                                "collectionMode": {
                                    "$ref": "#/definitions/TaxCollectionMode",
                                    "description": "Universal collection mode used to decide how tax cash is paid"
                                }
                            },
                            "required": [
                                "profileId",
                                "collectionMode"
                            ],
                            "additionalProperties": false,
                            "description": "Optional tax accounting configuration"
                        },
                        "initialMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Initial margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "maintenanceMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Maintenance margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "exchangeCommission": {
                            "$ref": "#/definitions/ICompositeGroup",
                            "description": "Commission applied when converting from source currency to account currency"
                        },
                        "commissionPerOrder": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per order side (charged twice for round-trip)"
                        },
                        "commissionPerContract": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per contract"
                        },
                        "allowMarketOrdersInExtendedHours": {
                            "type": "boolean",
                            "description": "Allow market orders in extended hours sessions"
                        },
                        "currency": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "defaultRiskProfileId",
                        "currency"
                    ],
                    "additionalProperties": false
                },
                "allowShorting": {
                    "type": "boolean",
                    "description": "Whether newly created simulated accounts may open short exposure."
                },
                "source": {
                    "type": "string",
                    "const": "provider"
                }
            },
            "required": [
                "accountTemplate",
                "allowShorting",
                "id",
                "port",
                "simulationProfile",
                "source"
            ],
            "additionalProperties": false,
            "description": "Follow source timestamps continuously; instruments are admitted when requested."
        },
        "ISimBrokerServiceProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Human-readable identity retained with the complete resolved policy.",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "slippage": {
                    "$ref": "#/definitions/ICompositeDynamicValue"
                },
                "randomness": {
                    "type": "number",
                    "description": "Probability that an ordinary order receives one injected execution scenario, not its severity.",
                    "minimum": 0,
                    "maximum": 1
                },
                "seed": {
                    "type": "string",
                    "description": "Stable experiment seed; account and economic order coordinates isolate deterministic draws.",
                    "minLength": 1,
                    "maxLength": 128
                },
                "spread": {
                    "$ref": "#/definitions/ICompositeDynamicValue"
                }
            },
            "additionalProperties": false,
            "required": [
                "id",
                "randomness",
                "seed"
            ],
            "description": "Standalone policy: full bar-volume capacity is engine-owned; quote-based spread is unavailable."
        },
        "ICompositeDynamicValue": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ICompositeValue"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "dynamic"
                        }
                    },
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "ICompositeValue": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "number",
                    "description": "Non-negative magnitude. With type \"perc\", this is a ratio from 0 to 1 resolved against the basis documented by the owning parameter; otherwise it uses that parameter's fixed unit.",
                    "minimum": 0
                },
                "type": {
                    "$ref": "#/definitions/IValueKind",
                    "description": "Value interpretation: \"fixed\" uses the owning parameter's unit and \"perc\" uses its documented basis. Defaults to \"fixed\"."
                }
            },
            "required": [
                "value"
            ],
            "additionalProperties": false
        },
        "IValueKind": {
            "type": "string",
            "enum": [
                "fixed",
                "perc"
            ]
        },
        "StrategySlug": {
            "type": "string",
            "const": "argo.quality-wide-target",
            "description": "Public production strategy slug type."
        },
        "TaxCollectionMode": {
            "type": "string",
            "enum": [
                "self_assessed",
                "withheld_by_intermediary",
                "none"
            ]
        },
        "ICompositeGroupPerInstrument": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/ICompositeGroup",
                "description": "Use symbol, instrument type or currency as key (E.g. AAPL, future, USD). Use `*` for default values"
            },
            "description": "Symbol or instrument type values"
        },
        "ICompositeGroup": {
            "type": "object",
            "properties": {
                "values": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ICompositeValue"
                    }
                },
                "minimum": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maximum": {
                    "$ref": "#/definitions/ICompositeValue"
                }
            },
            "required": [
                "values"
            ],
            "additionalProperties": false
        },
        "ISimBrokerHistoricalConfig": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Filesystem-safe identity; changing it starts a separate environment.",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                "port": {
                    "type": "number",
                    "description": "Loopback web/API port.",
                    "minimum": 1,
                    "maximum": 65535
                },
                "simulationProfile": {
                    "$ref": "#/definitions/ISimBrokerServiceProfile"
                },
                "accountTemplate": {
                    "type": "object",
                    "properties": {
                        "notificationsEnabled": {
                            "type": "boolean",
                            "description": "Whether this account may deliver notifications through globally configured channels; absence means disabled"
                        },
                        "soundsEnabled": {
                            "type": "boolean",
                            "description": "Whether the Live client may play position lifecycle sounds for this account; absence means disabled"
                        },
                        "instrumentPoolIds": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Instrument pool ids that the account can use. If undefined, the account can use all instruments available in the context."
                        },
                        "strategySlugs": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/StrategySlug"
                            },
                            "description": "Strategy slugs that the account can use. If undefined, the account can use all configured strategy slugs. Slugs are composed as `<series>.<branch>`."
                        },
                        "defaultRiskProfileId": {
                            "type": "string",
                            "description": "Complete risk profile selected for this account."
                        },
                        "maxLossPerDay": {
                            "$ref": "#/definitions/ICompositeValue",
                            "description": "Optional Backtest account replacement for trader.defaultMaxLossPerDay. Fixed values use account currency; percentage values use risk-day opening equity adjusted for nontrading cash flows. Historical and Live execution block subsequent entries after an observed breach without liquidating positions or canceling accepted orders. A selected entry-risk profile cannot change this account-wide limit."
                        },
                        "tax": {
                            "type": "object",
                            "properties": {
                                "profileId": {
                                    "type": "string",
                                    "description": "Country-level tax profile id"
                                },
                                "collectionMode": {
                                    "$ref": "#/definitions/TaxCollectionMode",
                                    "description": "Universal collection mode used to decide how tax cash is paid"
                                }
                            },
                            "required": [
                                "profileId",
                                "collectionMode"
                            ],
                            "additionalProperties": false,
                            "description": "Optional tax accounting configuration"
                        },
                        "initialMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Initial margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "maintenanceMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Maintenance margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "exchangeCommission": {
                            "$ref": "#/definitions/ICompositeGroup",
                            "description": "Commission applied when converting from source currency to account currency"
                        },
                        "commissionPerOrder": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per order side (charged twice for round-trip)"
                        },
                        "commissionPerContract": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per contract"
                        },
                        "allowMarketOrdersInExtendedHours": {
                            "type": "boolean",
                            "description": "Allow market orders in extended hours sessions"
                        },
                        "currency": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "defaultRiskProfileId",
                        "currency"
                    ],
                    "additionalProperties": false
                },
                "allowShorting": {
                    "type": "boolean",
                    "description": "Whether newly created simulated accounts may open short exposure."
                },
                "source": {
                    "type": "string",
                    "const": "historical"
                },
                "startDate": {
                    "type": "string",
                    "description": "Source UTC dates, inclusive. Provider timestamps remain unchanged."
                },
                "endDate": {
                    "type": "string"
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "playbackIntervalMs": {
                    "type": "number",
                    "description": "Wall-clock pacing of historical minutes, unrelated to provider delay.",
                    "minimum": 100,
                    "maximum": 60000
                }
            },
            "required": [
                "accountTemplate",
                "allowShorting",
                "endDate",
                "id",
                "playbackIntervalMs",
                "port",
                "simulationProfile",
                "source",
                "startDate",
                "symbols"
            ],
            "additionalProperties": false,
            "description": "Historical replay alone owns an explicit period, universe and wall-clock pacing."
        },
        "IOperationalTraderConfig": {
            "type": "object",
            "properties": {
                "strategies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/StrategySlug"
                    },
                    "description": "Strategy slugs selected by the caller; frozen runtime configurations contain resolved concrete keys."
                },
                "instrumentUniverse": {
                    "$ref": "#/definitions/IConfigInstrumentUniverse",
                    "description": "Instrument universe requested by the trader config"
                },
                "riskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigLiveRiskProfile"
                    },
                    "description": "Complete reusable entry-risk profiles selectable by accounts."
                },
                "targetExitTolerancePerc": {
                    "type": "number",
                    "description": "Maximum adverse retracement from a touched target at the completed-minute close. Expressed as a ratio of the raw target price: 0.002 means 0.2%. This controls Market submission, not the eventual fill price. Zero requires a close at or beyond target.",
                    "minimum": 0,
                    "maximum": 1
                },
                "defaultMaxLossPerDay": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Default hard account loss limit used when an account does not override it. Fixed values use account currency; percentage values use risk-day opening equity adjusted for nontrading cash flows. The observed limit blocks later entries in historical and Live execution without liquidation or cancellation of accepted orders. This limit is outside selectable and strategy profiles."
                },
                "maxContextBars": {
                    "type": "number",
                    "description": "Max bars per timeframe cached in context (memory/perf trade-off)"
                },
                "avoidRoundShareQuantities": {
                    "type": "boolean",
                    "description": "Avoid stock entry order sizes ending in 0 or 5 by subtracting two shares"
                },
                "approachingSignals": {
                    "$ref": "#/definitions/IConfigApproachSignals",
                    "description": "Approaching (pre-trigger) signals configuration"
                },
                "maxDrawings": {
                    "type": "number",
                    "description": "Maximum retained drawing lifetimes for each strategy and reference-symbol lane."
                },
                "live": {
                    "$ref": "#/definitions/IConfigLiveTrading"
                },
                "notifications": {
                    "type": "object",
                    "properties": {
                        "info": {
                            "$ref": "#/definitions/INotificationConfig"
                        },
                        "error": {
                            "$ref": "#/definitions/INotificationConfig"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "approachingSignals",
                "defaultMaxLossPerDay",
                "instrumentUniverse",
                "live",
                "maxContextBars",
                "maxDrawings",
                "notifications",
                "riskProfiles",
                "strategies",
                "targetExitTolerancePerc"
            ],
            "additionalProperties": false,
            "description": "Server defaults select only published production strategies; frozen day inputs resolve their keys."
        },
        "IConfigInstrumentUniverse": {
            "type": "object",
            "properties": {
                "poolIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Optional run-level pool ids selected from the global instrument pool catalog"
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Explicit symbols added on top of the selected pools"
                },
                "excludedSymbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Symbols excluded globally from the resolved universe"
                }
            },
            "additionalProperties": false,
            "description": "Instrument universe configuration"
        },
        "IConfigLiveRiskProfile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Complete profile id selected by an account or an explicit Backtest run."
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "description": "Maximum loss budget per trade as a ratio of available capital, where 1 is 100%. Signal confidence and HV modifiers can only reduce this budget. The resulting position is separately capped by maxCapitalPerTrade.",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "description": "Soft risk-day drawdown ratio, where 1 is 100%. It is measured from the tax-neutral performance-equity peak since the account risk-day boundary and blocks new entries without liquidating positions.",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRule",
                    "description": "Optional historical-volatility sizing rule. Its lookback extends strategy warmup, its bands scale the loss budget, and its shock estimates per-unit risk when the signal has no explicit stop distance."
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Minimum final capital allocation required to open a trade. Fixed values use account currency; percentage values use available capital at signal time. Orders below the resolved threshold are discarded. Example: 1_000 means skip trades that would allocate less than $1k."
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Maximum capital allocated per trade after loss-budget sizing. Fixed values use account currency; percentage values resolve against available capital at signal time before conversion to shares/contracts."
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Maximum spread accepted at the executable order price. Fixed values use price units and percentage values use the executable price; wider spreads discard the entry before order creation."
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "description": "Maximum share of the previous completed daily bar volume that a new order may request, where 1 is 100%. Missing usable daily volume discards the entry instead of assuming liquidity.",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "description": "Minimum number of recent completed one-minute execution bars with positive volume required before entry.",
                    "minimum": 0
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "description": "Maximum allowed gap between consecutive recent completed one-minute execution bars, expressed as a multiple of one minute.",
                    "exclusiveMinimum": 0
                },
                "minSignalScore": {
                    "type": "number",
                    "description": "Minimum confidence × causal strategy rank required before an entry may be sized.",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "id",
                "maxDrawdownPercPerDay",
                "maxRiskPercPerTrade"
            ],
            "description": "Entry-risk policy applicable to real broker execution."
        },
        "IConfigHVRule": {
            "type": "object",
            "properties": {
                "bands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "threshold": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "description": "Inclusive daily-HV upper bound for this band; null is the required final catch-all.",
                                "minimum": 0
                            },
                            "riskMultiplier": {
                                "type": "number",
                                "description": "Multiplier applied to the per-trade loss budget when observed daily HV falls in this band. It may reduce the base budget but cannot increase it above the configured maximum.",
                                "minimum": 0,
                                "maximum": 1
                            }
                        },
                        "required": [
                            "threshold",
                            "riskMultiplier"
                        ],
                        "additionalProperties": false
                    },
                    "description": "Ordered historical-volatility bands. The first threshold greater than or equal to the observed daily HV supplies its multiplier, and exactly one final null threshold is the required catch-all."
                },
                "lookbackDays": {
                    "type": "number",
                    "description": "Daily bars used to compute hvDaily for this profile. This sets the lookback window for volatility, not the sizing formula itself. Example: 10 for scalping, 20 for intraday, 30 for swing, 60 for position.",
                    "minimum": 1
                },
                "shock": {
                    "type": "number",
                    "description": "Multiple of daily HV used to estimate a \"shock\" per unit when no explicit stop distance is provided by the strategy. perUnitRisk = hvDaily * hvShockMultiple * price. Example: 1.5 ≈ 1.5 sigma shock.",
                    "exclusiveMinimum": 0
                }
            },
            "required": [
                "bands",
                "lookbackDays",
                "shock"
            ],
            "additionalProperties": false,
            "description": "Historical volatility-based risk rule configuration"
        },
        "IConfigApproachSignals": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "boolean",
                    "description": "Whether to consider approaching (pre-trigger) signals in order creation"
                },
                "notify": {
                    "type": "boolean",
                    "description": "Whether to send notifications for approaching signals"
                }
            },
            "required": [
                "active",
                "notify"
            ],
            "additionalProperties": false,
            "description": "Approaching (pre-trigger) signals configuration"
        },
        "IConfigLiveTrading": {
            "type": "object",
            "properties": {
                "logLevel": {
                    "type": "string",
                    "enum": [
                        "standard",
                        "verbose"
                    ],
                    "description": "Diagnostic detail written to the live journal log; standard still retains errors and signal outcomes."
                },
                "useStrategyScores": {
                    "type": "boolean",
