{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/ISimBrokerAccounting",
    "definitions": {
        "ISimBrokerAccounting": {
            "type": "object",
            "properties": {
                "sessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "economicTime": {
                    "type": "number",
                    "minimum": 1
                },
                "realizations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ITaxRealization"
                    }
                },
                "distributions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ICorporateActionDistribution"
                    }
                },
                "dividendAccruals": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IDividendAccrual"
                    }
                },
                "realizedPnl": {
                    "type": "number"
                },
                "dividendPnl": {
                    "type": "number"
                },
                "taxPaidCash": {
                    "type": "number"
                },
                "settledTaxYears": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            },
            "required": [
                "sessionId",
                "economicTime",
                "realizations",
                "distributions",
                "dividendAccruals",
                "realizedPnl",
                "dividendPnl",
                "taxPaidCash",
                "settledTaxYears"
            ],
            "additionalProperties": false,
            "description": "Complete economic evidence from one broker session; Gu retains tax-policy ownership."
        },
        "ITaxRealization": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "identity": {
                    "type": "string"
                },
                "sequence": {
                    "type": "number"
                },
                "time": {
                    "type": "number"
                }
            },
            "required": [
                "amount",
                "identity",
                "sequence",
                "time"
            ],
            "additionalProperties": false
        },
        "ICorporateActionDistribution": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable identity derived from the action and entitlement side."
                },
                "actionId": {
                    "type": "string",
                    "description": "Corporate action that created this settlement bucket."
                },
                "childPositionId": {
                    "type": "string",
                    "description": "Deterministic physical position identity reserved for whole child shares."
                },
                "parentSymbol": {
                    "type": "string"
                },
                "childSymbol": {
                    "type": "string"
                },
                "strategyId": {
                    "type": "string",
                    "const": "corporate-action-distribution",
                    "description": "Engine-reserved identity of the pooled physical position."
                },
                "currency": {
                    "type": "string",
                    "description": "Child instrument and account currencies respectively."
                },
                "accountCurrency": {
                    "type": "string"
                },
                "side": {
                    "$ref": "#/definitions/OrderSide",
                    "description": "Entitlement side shared by the bucket and all of its allocations."
                },
                "signedWholeChildSize": {
                    "type": "number",
                    "description": "Signed whole child shares delivered to the physical child position."
                },
                "signedFractionalCashInLieuSize": {
                    "type": "number",
                    "description": "Signed aggregate fractional child entitlement settled in cash."
                },
                "childAvgPrice": {
                    "type": "number",
                    "description": "Pooled raw and account-currency basis of the physical child position."
                },
                "childAvgLocalPrice": {
                    "type": "number"
                },
                "cashInLieuPrice": {
                    "type": "number",
                    "description": "Raw and account-currency barrier prices used for fractional settlement."
                },
                "cashInLieuLocalPrice": {
                    "type": "number"
                },
                "cashAdjustment": {
                    "type": "number",
                    "description": "Rounded account-currency totals produced by fractional settlement."
                },
                "realizedPnl": {
                    "type": "number"
                },
                "allocations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ICorporateActionDistributionAllocation"
                    },
                    "description": "Source-lineage allocations ordered by physical source and immediate allocation identity."
                },
                "appliedAt": {
                    "type": "number",
                    "description": "Causal barrier at which the entitlement was applied."
                },
                "appliedSequence": {
                    "type": "number",
                    "description": "Account-local causal sequence of the application barrier."
                }
            },
            "required": [
                "id",
                "actionId",
                "childPositionId",
                "parentSymbol",
                "childSymbol",
                "strategyId",
                "currency",
                "accountCurrency",
                "side",
                "signedWholeChildSize",
                "signedFractionalCashInLieuSize",
                "childAvgPrice",
                "childAvgLocalPrice",
                "cashInLieuPrice",
                "cashInLieuLocalPrice",
                "cashAdjustment",
                "realizedPnl",
                "allocations",
                "appliedAt",
                "appliedSequence"
            ],
            "additionalProperties": false,
            "description": "Immutable account-level settlement bucket created by one spin-off and one side. A non-zero whole entitlement seeds one pooled physical child position, while allocations preserve logical strategy lineages and fractional settlement."
        },
        "OrderSide": {
            "type": "number",
            "enum": [
                1,
                -1
            ],
            "description": "Logical side of the trade from the strategy viewpoint. How this maps to BUY/SELL depends on the instrument type. IMPORTANT: do NOT change these values as they are used in calculations!"
        },
        "ICorporateActionDistributionAllocation": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable identity derived from the action and immediate source identities."
                },
                "sourcePositionId": {
                    "type": "string",
                    "description": "Position whose shares created this entitlement."
                },
                "sourceAllocationId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Immediate beneficial allocation inside a pooled source, or null for a strategy-owned source."
                },
                "rootPositionId": {
                    "type": "string",
                    "description": "First strategy-created position in this entitlement lineage."
                },
                "strategyId": {
                    "type": "string",
                    "description": "Strategy that owns the logical source lineage."
                },
                "signedChildAllocationSize": {
                    "type": "number",
                    "description": "Signed beneficial share of the pooled whole-child position."
                },
                "signedFractionalCashInLieuSize": {
                    "type": "number",
                    "description": "Signed fractional entitlement settled as cash-in-lieu."
                },
                "childAvgPrice": {
                    "type": "number",
                    "description": "Child basis transferred from this source lineage in child and account currencies."
                },
                "childAvgLocalPrice": {
                    "type": "number"
                },
                "cashAdjustment": {
                    "type": "number",
                    "description": "Rounded account-currency cash and realized PnL attributed to this lineage."
                },
                "realizedPnl": {
                    "type": "number"
                }
            },
            "required": [
                "id",
                "sourcePositionId",
                "sourceAllocationId",
                "rootPositionId",
                "strategyId",
                "signedChildAllocationSize",
                "signedFractionalCashInLieuSize",
                "childAvgPrice",
                "childAvgLocalPrice",
                "cashAdjustment",
                "realizedPnl"
            ],
            "additionalProperties": false,
            "description": "Immutable attribution of one source lineage to a pooled spin-off settlement bucket."
        },
        "IDividendAccrual": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "dividendId": {
                    "type": "string"
                },
                "symbol": {
                    "type": "string"
                },
                "physicalPositionId": {
                    "type": "string"
                },
                "rootPositionId": {
                    "type": "string"
                },
                "strategyId": {
                    "type": "string"
                },
                "sourceAllocationId": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "signedUnits": {
                    "type": "number"
                },
                "cashAmountPerUnit": {
                    "type": "number"
                },
                "currency": {
                    "type": "string"
                },
                "accountCurrency": {
                    "type": "string"
                },
                "fxRate": {
                    "type": "number"
                },
                "fxObservationFingerprint": {
                    "type": "string"
                },
                "grossAmount": {
                    "type": "number"
                },
                "taxRate": {
                    "type": "number"
                },
                "taxTreatment": {
                    "$ref": "#/definitions/DividendTaxTreatment"
                },
                "exDividendDate": {
                    "type": "string"
                },
                "appliedAt": {
                    "type": "number"
                },
                "appliedSequence": {
                    "type": "number"
                }
            },
            "required": [
                "id",
                "dividendId",
                "symbol",
                "physicalPositionId",
                "rootPositionId",
                "strategyId",
                "sourceAllocationId",
                "signedUnits",
                "cashAmountPerUnit",
                "currency",
                "accountCurrency",
                "fxRate",
                "fxObservationFingerprint",
                "grossAmount",
                "taxRate",
                "taxTreatment",
                "exDividendDate",
                "appliedAt",
                "appliedSequence"
            ],
            "additionalProperties": false,
            "description": "Immutable journal-local attribution of one dividend amount to one logical lineage."
        },
        "DividendTaxTreatment": {
            "type": "string",
            "enum": [
                "taxable",
                "deductible",
                "non_deductible"
            ]
        }
    }
}
