{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IRuntimeTraderConfig",
    "definitions": {
        "IRuntimeTraderConfig": {
            "anyOf": [
                {
                    "$ref": "#/definitions/IBacktestTraderConfig"
                },
                {
                    "$ref": "#/definitions/ILiveTraderConfig"
                }
            ]
        },
        "IBacktestTraderConfig": {
            "type": "object",
            "properties": {
                "strategies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "instrumentUniverse": {
                    "$ref": "#/definitions/IConfigInstrumentUniverse"
                },
                "riskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigRiskProfile"
                    }
                },
                "strategyRiskOverrides": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigStrategyRiskOverride"
                    }
                },
                "targetExitTolerancePerc": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "strategyTargetExitOverrides": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigStrategyTargetExitOverride"
                    }
                },
                "defaultMaxLossPerDay": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxContextBars": {
                    "type": "number"
                },
                "avoidRoundShareQuantities": {
                    "type": "boolean"
                },
                "approachingSignals": {
                    "$ref": "#/definitions/IConfigApproachSignals"
                },
                "maxDrawings": {
                    "type": "number"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigBacktest"
                },
                "simulationProfile": {
                    "$ref": "#/definitions/ISimBrokerProfile"
                }
            },
            "required": [
                "approachingSignals",
                "backtest",
                "defaultMaxLossPerDay",
                "instrumentUniverse",
                "maxContextBars",
                "maxDrawings",
                "riskProfiles",
                "simulationProfile",
                "strategies",
                "strategyRiskOverrides",
                "strategyTargetExitOverrides",
                "targetExitTolerancePerc"
            ],
            "additionalProperties": false
        },
        "IConfigInstrumentUniverse": {
            "type": "object",
            "properties": {
                "poolIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "excludedSymbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "IConfigRiskProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRule"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigRiskBacktestProfile"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "minimum": 0
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "minSignalScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "id",
                "maxRiskPercPerTrade",
                "maxDrawdownPercPerDay"
            ],
            "additionalProperties": false
        },
        "IConfigHVRule": {
            "type": "object",
            "properties": {
                "bands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "threshold": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "minimum": 0
                            },
                            "riskMultiplier": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        },
                        "required": [
                            "threshold",
                            "riskMultiplier"
                        ],
                        "additionalProperties": false
                    }
                },
                "lookbackDays": {
                    "type": "number",
                    "minimum": 1
                },
                "shock": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            },
            "required": [
                "bands",
                "lookbackDays",
                "shock"
            ],
            "additionalProperties": false
        },
        "IConfigRiskBacktestProfile": {
            "type": "object",
            "properties": {
                "spreadFactor": {
                    "type": "number",
                    "minimum": 0
                },
                "slippageFactor": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "ICompositeValue": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "number",
                    "minimum": 0
                },
                "type": {
                    "$ref": "#/definitions/IValueKind"
                }
            },
            "required": [
                "value"
            ],
            "additionalProperties": false
        },
        "IValueKind": {
            "type": "string",
            "enum": [
                "fixed",
                "perc"
            ]
        },
        "IConfigStrategyRiskOverride": {
            "type": "object",
            "properties": {
                "strategyProfileId": {
                    "$ref": "#/definitions/StrategyRiskProfileId"
                },
                "preferredRiskProfileId": {
                    "type": "string"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRuleOverride"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigRiskBacktestProfile"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "minimum": 0
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "minSignalScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "strategyProfileId"
            ],
            "additionalProperties": false
        },
        "StrategyRiskProfileId": {
            "type": "string",
            "enum": [
                "default",
                "eventDriven",
                "scalping.trend",
                "scalping.breakout",
                "scalping.meanReversion",
                "scalping.range",
                "scalping.liquidity",
                "scalping.volatility",
                "intraday.trend",
                "intraday.breakout",
                "intraday.meanReversion",
                "intraday.range",
                "intraday.liquidity",
                "intraday.futures",
                "intraday.volatility",
                "swing.trend",
                "swing.breakout",
                "swing.meanReversion",
                "swing.range",
                "swing.liquidity",
                "swing.volatility",
                "position.trend",
                "position.breakout",
                "position.meanReversion",
                "position.range",
                "position.liquidity",
                "position.volatility"
            ]
        },
        "IConfigHVRuleOverride": {
            "type": "object",
            "properties": {
                "bands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "threshold": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "minimum": 0
                            },
                            "riskMultiplier": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        },
                        "required": [
                            "threshold",
                            "riskMultiplier"
                        ],
                        "additionalProperties": false
                    }
                },
                "lookbackDays": {
                    "type": "number",
                    "minimum": 1
                },
                "shock": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            },
            "additionalProperties": false
        },
        "IConfigStrategyTargetExitOverride": {
            "type": "object",
            "properties": {
                "strategyId": {
                    "type": "string"
                },
                "tolerancePerc": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "strategyId",
                "tolerancePerc"
            ],
            "additionalProperties": false
        },
        "IConfigApproachSignals": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "boolean"
                },
                "notify": {
                    "type": "boolean"
                }
            },
            "required": [
                "active",
                "notify"
            ],
            "additionalProperties": false
        },
        "IConfigBacktest": {
            "type": "object",
            "properties": {
                "useStrategyScores": {
                    "type": "boolean"
                },
                "startDate": {
                    "type": "string",
                    "format": "date-time"
                },
                "endDate": {
                    "type": "string",
                    "format": "date-time"
                },
                "optimization": {
                    "$ref": "#/definitions/IConfigBacktestOptimization"
                },
                "profiling": {
                    "type": "boolean"
                },
                "journalKind": {
                    "$ref": "#/definitions/JournalKind"
                },
                "initialCapital": {
                    "type": "number"
                }
            },
            "required": [
                "useStrategyScores",
                "initialCapital"
            ],
            "additionalProperties": false
        },
        "IConfigBacktestOptimization": {
            "type": "object",
            "properties": {
                "omitBenchmarks": {
                    "type": "boolean"
                },
                "omitSignals": {
                    "type": "boolean"
                },
                "omitNotifications": {
                    "type": "boolean"
                },
                "omitEquityCurve": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "JournalKind": {
            "type": "string",
            "enum": [
                "standard",
                "research",
                "oracle"
            ]
        },
        "ISimBrokerProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "spread": {
                    "$ref": "#/definitions/IBacktestSpreadValue"
                },
                "slippage": {
                    "$ref": "#/definitions/ICompositeDynamicValue"
                },
                "executionBarVolumeParticipation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "randomness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "seed": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            },
            "required": [
                "id",
                "executionBarVolumeParticipation",
                "randomness",
                "seed"
            ],
            "additionalProperties": false
        },
        "IBacktestSpreadValue": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ICompositeDynamicValue"
                },
                {
                    "$ref": "#/definitions/IObservedSpreadValue"
                }
            ]
        },
        "ICompositeDynamicValue": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ICompositeValue"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "dynamic"
                        }
                    },
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "IObservedSpreadValue": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "observed"
                },
                "minimumCoverage": {
                    "type": "number"
                },
                "maximumAgeMs": {
                    "type": "number"
                }
            },
            "required": [
                "type",
                "minimumCoverage",
                "maximumAgeMs"
            ],
            "additionalProperties": false
        },
        "ILiveTraderConfig": {
            "type": "object",
            "properties": {
                "strategies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "instrumentUniverse": {
                    "$ref": "#/definitions/IConfigInstrumentUniverse"
                },
                "riskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigLiveRiskProfile"
                    }
                },
                "strategyRiskOverrides": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigLiveStrategyRiskOverride"
                    }
                },
                "targetExitTolerancePerc": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "strategyTargetExitOverrides": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigStrategyTargetExitOverride"
                    }
                },
                "defaultMaxLossPerDay": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxContextBars": {
                    "type": "number"
                },
                "avoidRoundShareQuantities": {
                    "type": "boolean"
                },
                "approachingSignals": {
                    "$ref": "#/definitions/IConfigApproachSignals"
                },
                "maxDrawings": {
                    "type": "number"
                },
                "live": {
                    "$ref": "#/definitions/IConfigLiveTrading"
                },
                "notifications": {
                    "type": "object",
                    "properties": {
                        "info": {
                            "$ref": "#/definitions/INotificationConfig"
                        },
                        "error": {
                            "$ref": "#/definitions/INotificationConfig"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "approachingSignals",
                "defaultMaxLossPerDay",
                "instrumentUniverse",
                "live",
                "maxContextBars",
                "maxDrawings",
                "notifications",
                "riskProfiles",
                "strategies",
                "strategyRiskOverrides",
                "strategyTargetExitOverrides",
                "targetExitTolerancePerc"
            ],
            "additionalProperties": false
        },
        "IConfigLiveRiskProfile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRule"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "minimum": 0
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "minSignalScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "id",
                "maxDrawdownPercPerDay",
                "maxRiskPercPerTrade"
            ]
        },
        "IConfigLiveStrategyRiskOverride": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "strategyProfileId": {
                    "$ref": "#/definitions/StrategyRiskProfileId"
                },
                "preferredRiskProfileId": {
                    "type": "string"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRuleOverride"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "minimum": 0
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "minSignalScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "strategyProfileId"
            ]
        },
        "IConfigLiveTrading": {
            "type": "object",
            "properties": {
                "logLevel": {
                    "type": "string",
                    "enum": [
                        "standard",
                        "verbose"
                    ]
                },
                "useStrategyScores": {
                    "type": "boolean"
                }
            },
            "required": [
                "useStrategyScores"
            ],
            "additionalProperties": false
        },
        "INotificationConfig": {
            "type": "object",
            "properties": {
                "channels": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/NotificationChannel"
                    }
                },
                "webhooks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/INotificationConfigWebhook"
                    }
                },
                "telegram": {
                    "$ref": "#/definitions/INotificationConfigTelegram"
                }
            },
            "required": [
                "channels"
            ],
            "additionalProperties": false
        },
        "NotificationChannel": {
            "type": "string",
            "enum": [
                "app",
                "webhook",
                "telegram"
            ]
        },
        "INotificationConfigWebhook": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string"
                },
                "method": {
                    "type": "string",
                    "enum": [
                        "POST",
                        "GET"
                    ]
                },
                "messageWrapper": {
                    "type": "string"
                }
            },
            "required": [
                "url"
            ],
            "additionalProperties": false
        },
        "INotificationConfigTelegram": {
            "type": "object",
            "properties": {
                "chatIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "chatIds"
            ],
            "additionalProperties": false
        }
    }
}
