{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/ITradingAccountConfigInput",
    "definitions": {
        "ITradingAccountConfigInput": {
            "anyOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "currency": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string",
                            "const": "backtest"
                        },
                        "id": {
                            "type": "string",
                            "description": "Account id"
                        },
                        "active": {
                            "type": "boolean",
                            "description": "Whether the account is active"
                        },
                        "notificationsEnabled": {
                            "type": "boolean",
                            "description": "Whether this account may deliver notifications through globally configured channels; absence means disabled"
                        },
                        "soundsEnabled": {
                            "type": "boolean",
                            "description": "Whether the Live client may play position lifecycle sounds for this account; absence means disabled"
                        },
                        "instrumentPoolIds": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Instrument pool ids that the account can use. If undefined, the account can use all instruments available in the context."
                        },
                        "strategySlugs": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/StrategySlug"
                            },
                            "description": "Strategy slugs that the account can use. If undefined, the account can use all configured strategy slugs. Slugs are composed as `<series>.<branch>`."
                        },
                        "defaultRiskProfileId": {
                            "type": "string",
                            "description": "Complete risk profile selected for this account."
                        },
                        "maxLossPerDay": {
                            "$ref": "#/definitions/ICompositeValue",
                            "description": "Optional Backtest account replacement for trader.defaultMaxLossPerDay. Fixed values use account currency; percentage values use risk-day opening equity adjusted for nontrading cash flows. Historical and Live execution block subsequent entries after an observed breach without liquidating positions or canceling accepted orders. A selected entry-risk profile cannot change this account-wide limit."
                        },
                        "tax": {
                            "type": "object",
                            "properties": {
                                "profileId": {
                                    "type": "string",
                                    "description": "Country-level tax profile id"
                                },
                                "collectionMode": {
                                    "$ref": "#/definitions/TaxCollectionMode",
                                    "description": "Universal collection mode used to decide how tax cash is paid"
                                }
                            },
                            "required": [
                                "profileId",
                                "collectionMode"
                            ],
                            "additionalProperties": false,
                            "description": "Optional tax accounting configuration"
                        },
                        "initialMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Initial margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "maintenanceMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Maintenance margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "exchangeCommission": {
                            "$ref": "#/definitions/ICompositeGroup",
                            "description": "Commission applied when converting from source currency to account currency"
                        },
                        "commissionPerOrder": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per order side (charged twice for round-trip)"
                        },
                        "commissionPerContract": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per contract"
                        },
                        "allowMarketOrdersInExtendedHours": {
                            "type": "boolean",
                            "description": "Allow market orders in extended hours sessions"
                        },
                        "brokerAccount": {
                            "$ref": "#/definitions/IBrokerAccount",
                            "description": "Linked broker account information"
                        },
                        "$schema": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "active",
                        "brokerAccount",
                        "currency",
                        "defaultRiskProfileId",
                        "id",
                        "type"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "currency": {
                            "type": "string"
                        },
                        "type": {
                            "type": "string",
                            "enum": [
                                "paper",
                                "live"
                            ]
                        },
                        "id": {
                            "type": "string",
                            "description": "Account id"
                        },
                        "active": {
                            "type": "boolean",
                            "description": "Whether the account is active"
                        },
                        "notificationsEnabled": {
                            "type": "boolean",
                            "description": "Whether this account may deliver notifications through globally configured channels; absence means disabled"
                        },
                        "soundsEnabled": {
                            "type": "boolean",
                            "description": "Whether the Live client may play position lifecycle sounds for this account; absence means disabled"
                        },
                        "instrumentPoolIds": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Instrument pool ids that the account can use. If undefined, the account can use all instruments available in the context."
                        },
                        "strategySlugs": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/StrategySlug"
                            },
                            "description": "Strategy slugs that the account can use. If undefined, the account can use all configured strategy slugs. Slugs are composed as `<series>.<branch>`."
                        },
                        "defaultRiskProfileId": {
                            "type": "string",
                            "description": "Complete risk profile selected for this account."
                        },
                        "tax": {
                            "type": "object",
                            "properties": {
                                "profileId": {
                                    "type": "string",
                                    "description": "Country-level tax profile id"
                                },
                                "collectionMode": {
                                    "$ref": "#/definitions/TaxCollectionMode",
                                    "description": "Universal collection mode used to decide how tax cash is paid"
                                }
                            },
                            "required": [
                                "profileId",
                                "collectionMode"
                            ],
                            "additionalProperties": false,
                            "description": "Optional tax accounting configuration"
                        },
                        "initialMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Initial margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "maintenanceMarginPerContract": {
                            "type": "object",
                            "properties": {
                                "long": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                },
                                "short": {
                                    "$ref": "#/definitions/ICompositeGroupPerInstrument"
                                }
                            },
                            "additionalProperties": false,
                            "description": "Maintenance margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                        },
                        "exchangeCommission": {
                            "$ref": "#/definitions/ICompositeGroup",
                            "description": "Commission applied when converting from source currency to account currency"
                        },
                        "commissionPerOrder": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per order side (charged twice for round-trip)"
                        },
                        "commissionPerContract": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument",
                            "description": "Commission per contract"
                        },
                        "allowMarketOrdersInExtendedHours": {
                            "type": "boolean",
                            "description": "Allow market orders in extended hours sessions"
                        },
                        "brokerAccount": {
                            "$ref": "#/definitions/IBrokerAccount",
                            "description": "Linked broker account information"
                        },
                        "$schema": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "active",
                        "brokerAccount",
                        "currency",
                        "defaultRiskProfileId",
                        "id",
                        "type"
                    ]
                }
            ],
            "description": "Trading account representation accepted at the external configuration boundary."
        },
        "StrategySlug": {
            "type": "string",
            "const": "argo.quality-wide-target",
            "description": "Public production strategy slug type."
        },
        "ICompositeValue": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "number",
                    "description": "Non-negative magnitude. With type \"perc\", this is a ratio from 0 to 1 resolved against the basis documented by the owning parameter; otherwise it uses that parameter's fixed unit.",
                    "minimum": 0
                },
                "type": {
                    "$ref": "#/definitions/IValueKind",
                    "description": "Value interpretation: \"fixed\" uses the owning parameter's unit and \"perc\" uses its documented basis. Defaults to \"fixed\"."
                }
            },
            "required": [
                "value"
            ],
            "additionalProperties": false
        },
        "IValueKind": {
            "type": "string",
            "enum": [
                "fixed",
                "perc"
            ]
        },
        "TaxCollectionMode": {
            "type": "string",
            "enum": [
                "self_assessed",
                "withheld_by_intermediary",
                "none"
            ]
        },
        "ICompositeGroupPerInstrument": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/ICompositeGroup",
                "description": "Use symbol, instrument type or currency as key (E.g. AAPL, future, USD). Use `*` for default values"
            },
            "description": "Symbol or instrument type values"
        },
        "ICompositeGroup": {
            "type": "object",
            "properties": {
                "values": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ICompositeValue"
                    }
                },
                "minimum": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maximum": {
                    "$ref": "#/definitions/ICompositeValue"
                }
            },
            "required": [
                "values"
            ],
            "additionalProperties": false
        },
        "IBrokerAccount": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Broker account id"
                },
                "accountNumber": {
                    "type": "string",
                    "description": "Broker account number"
                },
                "type": {
                    "$ref": "#/definitions/BrokerType",
                    "description": "Broker type"
                },
                "apiKey": {
                    "type": "string",
                    "description": "Broker-specific configuration"
                },
                "apiSecret": {
                    "type": "string"
                },
                "gatewayHost": {
                    "type": "string",
                    "description": "Loopback address used by the Interactive Brokers Gateway or external SimBroker"
                },
                "gatewayPort": {
                    "type": "number",
                    "description": "Host port mapped to the Paper Gateway socket or SimBroker HTTP service"
                },
                "clientId": {
                    "type": "number",
                    "description": "TWS API client identity reserved for this Gu account worker"
                },
                "allowShorting": {
                    "type": "boolean",
                    "description": "Whether opening short positions is permitted"
                }
            },
            "required": [
                "id",
                "type"
            ],
            "additionalProperties": false
        },
        "BrokerType": {
            "type": "string",
            "enum": [
                "alpaca",
                "interactiveBrokers",
                "simulated"
            ]
        }
    }
}
